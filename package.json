{
  "name": "poe-build-architect",
  "version": "0.1.0",
  "description": "Optimiseur de builds Path of Exile 1 (3.29 Curse of the Allflame) basé sur le moteur de calcul Path of Building",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pba": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "pba": "node dist/cli.js",
    "setup": "bash scripts/setup-pob.sh",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
